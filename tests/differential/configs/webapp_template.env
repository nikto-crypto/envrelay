# =============================================================================
# Web application environment template
# Copy to .env and fill in the blanks. Lines starting with # are ignored.
# =============================================================================

# ---- Core -------------------------------------------------------------------
DEBUG=false
SECRET_KEY=
# Comma-separated list of hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ---------------------------------------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
DATABASE_URL=
DB_POOL_SIZE=5

# ---- Cache / queue ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=${REDIS_URL}

# ---- Email ------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
