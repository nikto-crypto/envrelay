## Self-hosting configuration
## -------------------------------------------------------------------
## Every value below has a sensible default; override what you need.

PUID=1000
PGID=1000
TZ=Etc/UTC

# Public URL the service is reached at (no trailing slash)
APP_URL=https://app.example.com

# Storage
DATA_DIR=/var/lib/app
# BACKUP_DIR=/mnt/backups

# Secrets (generate with: openssl rand -hex 32)
ADMIN_TOKEN=

# Feature flags
ENABLE_METRICS=false
ENABLE_SIGNUP=true
